{{!
    @template local_h5pchapteraccess/activity_summary

    Activity and extracted H5P manifest summary.
}}
<section class="card mb-4" aria-labelledby="local-h5pca-activity-summary-heading">
    <div class="card-body">
        <h2 class="h4" id="local-h5pca-activity-summary-heading">
            {{#str}} configurationstatus, local_h5pchapteraccess {{/str}}
        </h2>
        <div class="alert {{overviewclass}}" role="status">
            <strong>{{overviewtitle}}</strong> {{overviewmessage}}
        </div>
        <ul class="list-group mb-3">
            {{#checks}}
                <li class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                    <span><strong>{{label}}:</strong> {{value}}</span>
                    <span class="badge {{statusclass}} mt-2 mt-md-0">{{statuslabel}}</span>
                </li>
            {{/checks}}
        </ul>
        <p class="mb-2">
            <strong>{{#str}} chaptercounts, local_h5pchapteraccess {{/str}}:</strong>
            {{#str}} modeopen, local_h5pchapteraccess {{/str}}: {{opencount}};
            {{#str}} modelocked, local_h5pchapteraccess {{/str}}: {{lockedcount}};
            {{#str}} modeconditional, local_h5pchapteraccess {{/str}}: {{conditionalcount}}.
        </p>
        {{#hasunstable}}
            <p class="text-warning mb-3">
                {{#str}} unstablecountnotice, local_h5pchapteraccess, {{unstablecount}} {{/str}}
            </p>
        {{/hasunstable}}
        <a class="btn btn-secondary" href="{{activityurl}}">
            {{#str}} openactivity, local_h5pchapteraccess {{/str}}
        </a>
    </div>
</section>
<div class="alert alert-warning" role="note">{{deploymentnotice}}</div>
<div class="alert alert-info" role="note">{{studentviewnotice}}</div>
<details class="card mb-4">
    <summary class="card-header">
        <strong>{{#str}} technicaldetails, local_h5pchapteraccess {{/str}}</strong>
    </summary>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">{{#str}} activityname, local_h5pchapteraccess {{/str}}</dt>
            <dd class="col-sm-8">{{activityname}}</dd>
            <dt class="col-sm-4">{{#str}} coursemoduleid, local_h5pchapteraccess {{/str}}</dt>
            <dd class="col-sm-8">{{cmid}}</dd>
            <dt class="col-sm-4">{{#str}} contentid, local_h5pchapteraccess {{/str}}</dt>
            <dd class="col-sm-8">{{contentid}}</dd>
            <dt class="col-sm-4">{{#str}} contenthash, local_h5pchapteraccess {{/str}}</dt>
            <dd class="col-sm-8"><code>{{contenthash}}</code></dd>
            <dt class="col-sm-4">{{#str}} manifesthash, local_h5pchapteraccess {{/str}}</dt>
            <dd class="col-sm-8"><code>{{manifesthash}}</code></dd>
            <dt class="col-sm-4">{{#str}} activechaptercount, local_h5pchapteraccess {{/str}}</dt>
            <dd class="col-sm-8">{{activecount}}</dd>
        </dl>
    </div>
</details>
