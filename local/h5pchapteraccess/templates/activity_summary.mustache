{{!
    @template local_h5pchapteraccess/activity_summary

    Concise activity access overview for teachers.
}}
<section class="card local-h5pca-summary mb-4" aria-labelledby="local-h5pca-summary-heading">
    <div class="card-body">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
            <div>
                <p class="text-uppercase text-muted small fw-bold mb-1">
                    {{#str}} navigationtitle, local_h5pchapteraccess {{/str}}
                </p>
                <h2 class="h3 mb-2" id="local-h5pca-summary-heading">{{activityname}}</h2>
                <p class="mb-0">
                    <span class="local-h5pca-status-dot {{statusclass}}" aria-hidden="true"></span>
                    <strong>{{statustitle}}</strong> {{statusmessage}}
                </p>
            </div>
            <div class="align-self-lg-center">
                <a class="btn btn-outline-secondary" href="{{activityurl}}">
                    {{#str}} previewactivity, local_h5pchapteraccess {{/str}}
                </a>
            </div>
        </div>

        <div class="local-h5pca-counts mt-3" aria-label="{{#str}} chaptercounts, local_h5pchapteraccess {{/str}}">
            <span class="local-h5pca-count local-h5pca-count-open">
                {{#str}} countopen, local_h5pchapteraccess {{/str}}: {{opencount}}
            </span>
            <span class="local-h5pca-count local-h5pca-count-locked">
                {{#str}} countlocked, local_h5pchapteraccess {{/str}}: {{lockedcount}}
            </span>
            <span class="local-h5pca-count local-h5pca-count-conditional">
                {{#str}} countconditional, local_h5pchapteraccess {{/str}}: {{conditionalcount}}
            </span>
        </div>

        {{^hasrules}}
            <div class="alert alert-info mt-3 mb-0" role="status">
                {{#str}} norulesconfigured, local_h5pchapteraccess {{/str}}
            </div>
        {{/hasrules}}

        {{#hasdeploymentissues}}
            <div class="alert alert-danger mt-3 mb-0" role="alert">
                <strong>{{#str}} communicationproblem, local_h5pchapteraccess {{/str}}</strong>
                <ul class="mb-0 mt-1">
                    {{#deploymentissues}}<li>{{.}}</li>{{/deploymentissues}}
                </ul>
            </div>
        {{/hasdeploymentissues}}
    </div>
</section>
